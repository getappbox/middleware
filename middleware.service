[Unit]
Description=AppBox Middleware
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=middleware
Group=middleware
WorkingDirectory=/opt/appbox-middleware
ExecStart=/opt/appbox-middleware/bin/middleware serve --env production
Environment="PORT=2550"
EnvironmentFile=-/opt/appbox-middleware/.env
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=appbox-middleware

[Install]
WantedBy=multi-user.target
